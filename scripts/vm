#!/usr/bin/env python3
"""Drive Lima --plain guests for multi-OS e2e over SSH.

Usage (from the repo root)::

    uv run python scripts/vm up debian
    uv run python scripts/vm ssh debian
    uv run python scripts/vm test debian -- -m e2e
    uv run python scripts/vm debug-log
    uv run python scripts/vm debug-log vm debian -- -m e2e
"""

from __future__ import annotations

import argparse
import os
import shlex
import shutil
import subprocess
import sys
from collections.abc import Sequence
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
VM_DIR = REPO / "vm" / "lima"
LIMA_HOME = Path(os.environ.get("LIMA_HOME", Path.home() / ".lima"))
GOLDEN_TAG = "golden"
DEFAULT_GUEST = "debian"
GUESTS: dict[str, Path] = {
    "archlinux": VM_DIR / "archlinux.yaml",
    "debian": VM_DIR / "debian.yaml",
    "ubuntu-26.04": VM_DIR / "ubuntu-26.04.yaml",
}
# Short names people type. ``ubuntu`` is the current LTS.
ALIASES = {
    "arch": "archlinux",
    "ubuntu": "ubuntu-26.04",
    "ubuntu-lts": "ubuntu-26.04",
    "resolute": "ubuntu-26.04",
    "trixie": "debian",
    "debian-13": "debian",
}
RSYNC_EXCLUDES = (
    ".git",
    ".venv",
    "debug.log",
    ".ruff_cache",
    ".pytest_cache",
    "htmlcov",
    ".coverage",
    "__pycache__",
    "*.pyc",
)


def instance_name(guest: str) -> str:
    return f"bk-{guest}"


def ssh_config(guest: str) -> Path:
    return LIMA_HOME / instance_name(guest) / "ssh.config"


def ssh_host(guest: str) -> str:
    """Return the ``Host`` alias Lima wrote (dots become dashes, e.g. 24-04)."""
    cfg = ssh_config(guest)
    if cfg.is_file():
        for line in cfg.read_text(encoding="utf-8").splitlines():
            parts = line.split()
            if len(parts) >= 2 and parts[0].lower() == "host":
                return parts[1]
    return f"lima-{instance_name(guest).replace('.', '-')}"


# Lima's ssh.config uses a ControlMaster. A reused master keeps the login
# groups from first boot, so a later ``usermod -aG docker`` is invisible.
SSH_FRESH = ("-o", "ControlMaster=no", "-o", "ControlPath=none")


def _strip_dd(args: Sequence[str]) -> list[str]:
    rest = list(args)
    if rest and rest[0] == "--":
        return rest[1:]
    return rest


def normalize_guest(name: str) -> str | None:
    """Map ``ubuntu26.04`` / ``Ubuntu-26.04`` / ``arch`` / ``trixie`` to a GUESTS key."""
    key = name.strip().lower()
    if key == "all" or key in GUESTS:
        return key
    if key in ALIASES:
        return ALIASES[key]
    # ubuntu26.04 -> ubuntu-26.04
    for guest in GUESTS:
        if key == guest.replace("-", ""):
            return guest
    return None


def _guest_choices() -> str:
    return ", ".join((*GUESTS, *ALIASES, "all"))


def _looks_like_pytest_arg(token: str) -> bool:
    if token.startswith("-"):
        return True
    path = token.split("::", 1)[0]
    return (REPO / path).exists() or "/" in path or path.endswith(".py")


def parse_guest_and_rest(args: Sequence[str]) -> tuple[str, list[str]]:
    rest = _strip_dd(args)
    if not rest:
        return DEFAULT_GUEST, rest
    guest = normalize_guest(rest[0])
    if guest is not None:
        return guest, rest[1:]
    if _looks_like_pytest_arg(rest[0]):
        return DEFAULT_GUEST, rest
    sys.exit(f"unknown guest {rest[0]!r}; choose from {_guest_choices()}")


def guests_of(name: str) -> list[str]:
    guest = normalize_guest(name)
    if guest is None:
        sys.exit(f"unknown guest {name!r}; choose from {_guest_choices()}")
    if guest == "all":
        return list(GUESTS)
    return [guest]


def limactl_bin() -> str:
    path = shutil.which("limactl")
    if path is None:
        sys.exit(
            "limactl is not on PATH (Arch: AUR lima or lima-bin, or the upstream tarball)"
        )
    if os.geteuid() == 0:
        sys.exit("limactl must not run as root")
    return path


def lima(*args: str, check: bool = True) -> subprocess.CompletedProcess[str]:
    return subprocess.run([limactl_bin(), *args], check=check, text=True)


def instance_exists(guest: str) -> bool:
    return (LIMA_HOME / instance_name(guest) / "lima.yaml").is_file()


def warn_kvm() -> None:
    kvm = Path("/dev/kvm")
    if not kvm.exists() or not os.access(kvm, os.R_OK | os.W_OK):
        print(
            "warning: /dev/kvm is missing or not writable (join the kvm group); "
            "QEMU will be slow or fail",
            file=sys.stderr,
        )


def cmd_up(guest: str) -> None:
    warn_kvm()
    name = instance_name(guest)
    if instance_exists(guest):
        lima("start", "--tty=false", name)
        return
    template = GUESTS[guest]
    if not template.is_file():
        sys.exit(f"missing template {template}")
    print(f"creating {name} from {template} (first boot pulls the cloud image)…", flush=True)
    lima("start", "--tty=false", "--name", name, str(template))


def cmd_down(guest: str) -> None:
    lima("stop", instance_name(guest))


def cmd_rm(guest: str) -> None:
    """Delete the instance; Lima copies the template at create, so edits need a rebuild."""
    if instance_exists(guest):
        lima("delete", "--force", instance_name(guest))


def ssh_argv(guest: str, remote: Sequence[str]) -> list[str]:
    cfg = ssh_config(guest)
    if not cfg.is_file():
        sys.exit(f"missing {cfg}; run: just vm-up {guest}")
    cmd = ["ssh", "-F", str(cfg), *SSH_FRESH, ssh_host(guest)]
    remote = _strip_dd(remote)
    if remote:
        cmd.append("--")
        cmd.extend(remote)
    return cmd


def cmd_ssh(guest: str, remote: Sequence[str]) -> int:
    return subprocess.call(ssh_argv(guest, remote))


def cmd_sync(guest: str) -> None:
    if shutil.which("rsync") is None:
        sys.exit("rsync is required on the host to copy the checkout into the guest")
    cfg = ssh_config(guest)
    if not cfg.is_file():
        sys.exit(f"missing {cfg}; run: just vm-up {guest}")
    dest = f"{ssh_host(guest)}:buddelkiste/"
    argv = [
        "rsync",
        "-a",
        "--delete",
        "-e",
        shlex.join(["ssh", "-F", str(cfg), *SSH_FRESH]),
        *[f"--exclude={pattern}" for pattern in RSYNC_EXCLUDES],
        f"{REPO}/",
        dest,
    ]
    subprocess.run(argv, check=True)


def remote_pytest(pytest_args: Sequence[str]) -> str:
    extra = shlex.join(_strip_dd(pytest_args))
    pytest = "uv run pytest" if not extra else f"uv run pytest {extra}"
    return (
        "set -euo pipefail; "
        'export PATH="$HOME/.local/bin:$PATH"; '
        'cd "$HOME/buddelkiste"; '
        "uv sync --group dev; "
        f"{pytest}"
    )


def cmd_test(guest: str, pytest_args: Sequence[str]) -> int:
    status = 0
    for name in guests_of(guest):
        print(f"===== vm-test {name} =====", flush=True)
        try:
            cmd_up(name)
            cmd_sync(name)
        except (subprocess.CalledProcessError, SystemExit) as exc:
            code = getattr(exc, "returncode", None) or getattr(exc, "code", None) or 1
            status = code if isinstance(code, int) else 1
            print(f"===== vm-test {name} SETUP FAILED ({exc}) =====", flush=True)
            continue
        code = cmd_ssh(name, [remote_pytest(pytest_args)])
        if code != 0:
            status = code
            print(f"===== vm-test {name} FAILED ({code}) =====", flush=True)
        else:
            print(f"===== vm-test {name} OK =====", flush=True)
    return status


def cmd_snapshot(guest: str) -> None:
    name = instance_name(guest)
    lima("stop", name, check=False)
    lima("snapshot", "create", name, "--tag", GOLDEN_TAG)


def cmd_restore(guest: str) -> None:
    name = instance_name(guest)
    lima("stop", name, check=False)
    lima("snapshot", "apply", name, "--tag", GOLDEN_TAG)
    lima("start", "--tty=false", name)


def cmd_debug_log(rest: Sequence[str]) -> int:
    rest = _strip_dd(rest)
    if rest[:1] == ["vm"]:
        guest, pytest_args = parse_guest_and_rest(rest[1:])
        return cmd_test(guest, pytest_args)
    if rest[:1] == ["host"]:
        rest = rest[1:]
    return subprocess.call(["uv", "run", "pytest", *_strip_dd(rest)], cwd=REPO)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="cmd", required=True)

    p_up = sub.add_parser("up", help="start (or create) a guest")
    p_up.add_argument("guest", nargs="?", default=DEFAULT_GUEST)

    p_down = sub.add_parser("down", help="stop a guest")
    p_down.add_argument("guest", nargs="?", default=DEFAULT_GUEST)

    p_rm = sub.add_parser("rm", help="delete a guest (rebuild after editing vm/lima/*.yaml)")
    p_rm.add_argument("guest", nargs="?", default=DEFAULT_GUEST)

    p_ssh = sub.add_parser("ssh", help="ssh into a guest; remaining args are the remote command")
    p_ssh.add_argument("guest", nargs="?", default=DEFAULT_GUEST)
    p_ssh.add_argument("remote", nargs=argparse.REMAINDER)

    p_sync = sub.add_parser("sync", help="rsync the checkout into ~/buddelkiste on the guest")
    p_sync.add_argument("guest", nargs="?", default=DEFAULT_GUEST)

    p_test = sub.add_parser("test", help="up + sync + remote pytest (guest may be 'all')")
    p_test.add_argument("guest", nargs="?", default=DEFAULT_GUEST)
    p_test.add_argument("pytest_args", nargs=argparse.REMAINDER)

    p_snap = sub.add_parser("snapshot", help="stop the guest and save a disk snapshot tag=golden")
    p_snap.add_argument("guest", nargs="?", default=DEFAULT_GUEST)

    p_restore = sub.add_parser("restore", help="stop, apply golden, start")
    p_restore.add_argument("guest", nargs="?", default=DEFAULT_GUEST)

    p_debug = sub.add_parser(
        "debug-log",
        help="host or vm pytest; just debug-log tees stdout to debug.log",
    )
    p_debug.add_argument("rest", nargs=argparse.REMAINDER)

    sub.add_parser("guests", help="list known guests")
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    if args.cmd == "guests":
        print("\n".join(GUESTS))
        return 0
    if args.cmd == "up":
        for name in guests_of(args.guest):
            cmd_up(name)
        return 0
    if args.cmd == "down":
        for name in guests_of(args.guest):
            cmd_down(name)
        return 0
    if args.cmd == "rm":
        for name in guests_of(args.guest):
            cmd_rm(name)
        return 0
    if args.cmd == "ssh":
        guest, remote = parse_guest_and_rest([args.guest, *args.remote])
        if guest == "all":
            sys.exit("ssh needs a single guest, not 'all'")
        return cmd_ssh(guest, remote)
    if args.cmd == "sync":
        for name in guests_of(args.guest):
            cmd_sync(name)
        return 0
    if args.cmd == "test":
        guest, pytest_args = parse_guest_and_rest([args.guest, *args.pytest_args])
        return cmd_test(guest, pytest_args)
    if args.cmd == "snapshot":
        for name in guests_of(args.guest):
            cmd_snapshot(name)
        return 0
    if args.cmd == "restore":
        for name in guests_of(args.guest):
            cmd_restore(name)
        return 0
    if args.cmd == "debug-log":
        return cmd_debug_log(args.rest)
    return 2


if __name__ == "__main__":
    sys.exit(main())
